# ==========================================
# Sarbix School OS — Root .gitignore
# ==========================================

# Dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js & Web Build Artifacts
.next/
**/.next/
out/
**/out/
build/
dist/

# TypeScript Cache
*.tsbuildinfo
**/*.tsbuildinfo

# Secrets & Environment Variables (Keep Protected)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env.local
**/.env*.local
*.pem
*.key

# Python Artifacts (PDF Generation)
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
env/
venv/
ENV/

# Agent / Scratch Workspaces & Temporary Logs
Agent Files/
.agents/
.gemini/
*.log
scratch/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# IDE & Editor Configuration
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
